{
  "name": "planet-view",
  "version": "2.8.2",
  "private": true,
  "type": "module",
  "description": "Chrome extension displaying Planet imagery",
  "repository": {
    "type": "git",
    "url": "https://github.com/planetlabs/planet-view-chrome-ext.git"
  },
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/planetlabs/planet-view-chrome-ext/issues"
  },
  "homepage": "https://github.com/planetlabs/planet-view-chrome-ext",
  "scripts": {
    "start": "vite serve",
    "build": "vite build",
    "postbuild": "mkdir -p dist/assets && cp src/manifest.json dist/manifest.json && cp -r src/assets/images dist/assets",
    "lint": "eslint src vite.config.js eslint.config.js",
    "pretest": "npm run lint",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest"
  },
  "dependencies": {
    "d3": "^7.4.4",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "dom-storage": "^2.1.0",
    "eslint": "^10.10.0",
    "eslint-config-planet": "^23.3.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "json": "^11.0.0",
    "semver": "^7.8.5",
    "vite": "^8.3.0"
  },
  "jest": {
    "transform": {}
  }
}
